// prisma/schema.prisma
//
// This project uses Prisma *only* as its migration tool — schema changes are
// expressed here and shipped as SQL files under prisma/migrations/, applied
// with `prisma migrate deploy` on startup (see scripts/migrate.js and the
// Dockerfile), the same way the rest of this repository's schema changes are
// made. There is no generated Prisma Client and no `generator` block: all
// runtime reads/writes to user_preferences still go through mysql2 directly
// via parameterized queries (see db.js / preferencesRepo.js). This keeps the
// dedicated-preferences-table-with-cache behaviour — debounced writes,
// in-memory render vars for instant feedback, LRU-cached reads — completely
// unchanged; only how the table's schema is created/versioned has moved from
// an ad-hoc `CREATE TABLE IF NOT EXISTS` at boot to a real, withdrawable
// migration.
//
// Production is MySQL 8.4, not SQLite — every column below carries an
// explicit length (or, for updated_at, an explicit width) because MySQL
// requires one for VARCHAR/CHAR and has no "TEXT PRIMARY KEY" the way SQLite
// does (that's exactly what made the original SQLite-flavoured migration
// fail with error 1064 against a real MySQL server).

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserPreference {
  // Google OAuth `sub`, or the legacy login username — both comfortably fit
  // well under 191 chars, the longest VARCHAR MySQL can still fully index
  // with a default utf8mb4 collation (767-byte prefix limit / 4 bytes-per-char).
  userId      String  @id @map("user_id") @db.VarChar(191)
  // Hex colors are always exactly 7 chars ("#rrggbb" — see HEX_COLOR_RE in
  // preferencesRepo.js), so the column is sized to match exactly.
  paddleColor String  @map("paddle_color") @db.VarChar(7)
  ballColor   String  @map("ball_color") @db.VarChar(7)
  bgColor     String  @map("bg_color") @db.VarChar(7)
  presetName  String? @map("preset_name") @db.VarChar(50)
  // Stored as epoch milliseconds (Date.now()), same as before — a BIGINT
  // avoids any lossy conversion to/from MySQL's DATETIME on every read/write.
  updatedAt   BigInt  @map("updated_at")

  @@map("user_preferences")
}
