// Prisma schema for the Pong backend.
//
// Connection info comes exclusively from the DATABASE_URL environment
// variable (a MySQL connection string, e.g.
// "mysql://user:password@host:3306/pong"). No host/port/credentials are
// hard-coded here or anywhere else in the app — see lib/prisma.js.
//
// Pong authenticates exclusively via Google Sign-In (see server.js), so
// User has no password column and this app never touches bcrypt: the
// "login key" is Google's stable OAuth subject id (`sub`), stored as
// User.id.
//
// Migrations are checked into prisma/migrations/ and applied at container
// startup with `prisma migrate deploy` (never `prisma db push`), so a fresh
// database ends up with exactly this schema and nothing else.

generator client {
  provider      = "prisma-client-js"
  // node:20-alpine (musl libc, OpenSSL 3) is the base image used by this
  // app's Dockerfile — "native" alone would resolve to the wrong engine
  // binary when `prisma generate` runs on a glibc dev machine but the
  // container itself runs musl.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// A Google-authenticated player. `id` is Google's stable OAuth subject id
// (`profile.id` / the `sub` claim) — it is never generated by this app, and
// it is the key every other table hangs off of.
// nickname is a player-chosen display name (1-20 alphanumeric characters or
// spaces, set via PATCH /api/user/nickname — see server.js), shown instead
// of the Google account name/email wherever a player's identity appears
// next to a score. Nullable — most rows have none until the player sets one
// from the inline editor in the header. The physical column is prefixed
// `mendel_exp_` (this table is shared by every concurrently-running
// variation of this hop, each applying its own migration against the same
// database) while the Prisma field name stays unprefixed for application
// code.
model User {
  id        String   @id
  email     String?  @unique
  name      String?
  avatar    String?
  nickname  String?  @map("mendel_exp_nickname_inline_header_editor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preference   Preference?
  highScore    HighScore?
  gameHistory  GameHistory[]

  @@map("users")
}

// Per-user game settings. One row per user (enforced by the unique
// `userId`); created lazily the first time a user saves a preference.
model Preference {
  id           Int      @id @default(autoincrement())
  userId       String   @unique
  theme        String   @default("dark")
  soundEnabled Boolean  @default(true)
  paddleColor  String   @default("#ffffff")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

// A single player's best score. One row per user (enforced by the unique
// `userId`) — a new submission only overwrites it when strictly higher.
//
// longestRally is that same player's longest-ever rally (consecutive
// paddle hits without a miss, tracked client-side per game — see
// game-logic.js's `rally.maxRally`) — an independent running best,
// bumped in the same POST /api/scores write whenever a finished game's
// rally exceeds it, regardless of whether that game also beat `score`.
// The physical column is prefixed `mendel_exp_` (this table is shared by
// every concurrently-running variation of this hop, each applying its own
// migration against the same database) while the Prisma field name stays
// unprefixed for application code.
model HighScore {
  id           Int      @id @default(autoincrement())
  userId       String   @unique
  score        Int
  longestRally Int      @default(0) @map("mendel_exp_longest_rally")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score])
  @@map("high_scores")
}

// A single played game's result. Unlike HighScore (one row per user, only
// ever overwritten by a strictly-higher score), every finished game gets its
// own row here — the two tables are written independently and neither reads
// from the other. `duration` is the game length in seconds.
model GameHistory {
  id         Int      @id @default(autoincrement())
  userId     String
  score      Int
  duration   Int
  finishedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, finishedAt])
  @@map("game_history")
}
