{
  "name": "game-canvas-scaffold",
  "version": "1.0.0",
  "description": "Pong game with Node.js/Express API and PostgreSQL high-score backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test":  "jest --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"],
    "testTimeout": 15000
  },
  "dependencies": {
    "bcrypt":       "^5.1.1",
    "cors":         "^2.8.5",
    "express":      "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg":           "^8.11.3"
  },
  "devDependencies": {
    "jest":       "^29.7.0",
    "supertest":  "^6.3.4"
  }
}
